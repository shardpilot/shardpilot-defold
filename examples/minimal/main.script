-- ⚠ POLICY FIRST, SDK SECOND. consent_policy.prepare is the first
-- integration call, and this file is the executable statement of that
-- ordering: shardpilot.init() is not reached until the decision has arrived.
--
-- The requires below are not the barrier — requiring shardpilot.sdk loads
-- code and creates nothing (sdk.lua:1-4). init() is: it builds the client,
-- which loads the persisted scope record and mints an anonymous identifier
-- (client.lua:763-787). Calling it before the policy decision would create an
-- identity for a player whose regime had not yet been established.
local consent_policy = require "shardpilot.consent_policy"
local platform = require "shardpilot.platform"
local shardpilot = require "shardpilot.sdk"
local crash = require "shardpilot.crash"

-- Set once the decision has arrived and the SDK has been started. update()
-- and final() check it, because before that there is no SDK to drive.
local started = false

-- Where this example parks a remote-config value; your game reads it wherever
-- it needs the tuned number.
local spawn_rate = 1.0

local function start_shardpilot(decision)
	-- ⚠ A DECISION IS NOT CONSENT. It says which regime applies and whether
	-- the optional lane is closed whatever the player answers; the player
	-- still has to be asked, with the notice that regime requires.
	-- decision.plan_used = false means the strict fallback was taken (the
	-- resolver was unreachable, or answered something this build would not
	-- accept) — that path tightens, it never relaxes.
	print("shardpilot consent regime: " .. tostring(decision.regime) ..
		(decision.plan_used and "" or " (strict fallback: " .. tostring(decision.reason) .. ")"))

	shardpilot.init({
		ingest_url = "http://localhost:8080",
		workspace_id = "workspace-example",
		app_id = "app-example",
		environment_id = "develop",
		token_provider = function(callback)
			callback("client-token-placeholder", nil, nil)
		end,
		-- Remote config (optional). A separate endpoint from ingest_url; it
		-- authenticates with the publishable api_key, so enabling it under
		-- Mode B requires the api_key too. See docs/configuration.md.
		remote_config_url = "http://localhost:8081",
		api_key = "sp_ingest_publishable_placeholder",
	})
	shardpilot.identify("user-example")
	-- Consent-first: the analytics pipeline transmits NOTHING until an
	-- explicit grant — while consent is undecided, track/session calls return
	-- false, "consent_unknown" and the event is dropped, not held. Wire this
	-- to your consent UX and call set_consent(false) on decline — or
	-- set_consent("denied_forced_minor") when your age gate forces the denial
	-- (feature-detect it with
	-- shardpilot.supports("consent_state_denied_forced_minor")). Each explicit
	-- decision posts a consent receipt kept in a durable outbox until the
	-- server acknowledges it, so a decision made offline still reaches the
	-- backend on a later launch.
	shardpilot.set_consent(true)
	shardpilot.session_start()

	-- Remote config: fetch explicitly (the SDK never fetches on its own).
	-- Getters serve the durable last-known-good snapshot immediately —
	-- including offline and before this fetch completes — and the caller's
	-- default until any configuration is available.
	shardpilot.fetch_remote_config(function(result)
		if not result.ok then
			print("shardpilot remote config unavailable: " .. tostring(result.error))
		end
	end)
	spawn_rate = shardpilot.remote_config_number("spawn_rate", 1.0)

	-- Crash reporting. A separate module, endpoint, and crash:write
	-- key — see docs/crash.md. It is ON by default (independent of the
	-- analytics consent above) with a persisted per-app opt-out:
	-- crash.set_enabled(false) stops collection entirely.
	-- init auto-forwards a previous-session native crash dump (set
	-- capture_previous_on_boot = false for the manual flow).
	crash.init({
		crash_ingest_url = "http://localhost:8080",
		crash_api_key = "sp_crash_write_placeholder",
		app_id = "app-example",
		crash_source = "game-client",
		-- script_error_capture_enabled = true, -- opt-in Lua error auto-capture
	})

	-- Offline durability: snapshot undelivered events to the durable spool
	-- when the app loses focus or is iconified — on mobile an iconified app
	-- can be killed without final() ever running. The SDK never installs
	-- global listeners itself. NOTE: Defold keeps a single window listener
	-- (window.set_listener replaces any previously set one), so put the
	-- persist() branch inside your game's existing listener.
	if window and window.set_listener then
		window.set_listener(function(self, event, data)
			-- ... your existing resize/focus/iconify handling ...
			if event == window.WINDOW_EVENT_ICONFIED or event == window.WINDOW_EVENT_FOCUS_LOST then
				shardpilot.persist()
			end
		end)
	end

	started = true
end

function init(self)
	-- The policy endpoint is a third service of its own, separate from
	-- ingest_url and remote_config_url.
	--
	-- platform.detect() is the HOST mapping its own system name into the
	-- closed vocabulary the policy accepts; consent_policy itself imports
	-- nothing from this SDK, and platform.lua only reads sys info
	-- (platform.lua:19-29). On a system it cannot map it returns nil, the
	-- context is refused as invalid_request without a request leaving the
	-- device, and the callback receives the strict decision — which is the
	-- conservative answer, not a failure to handle.
	consent_policy.prepare({
		endpoint = "http://localhost:8082",
		workspace_id = "workspace-example",
		app_id = "app-example",
		environment_id = "develop",
		app_version = "1.0.0",
		locale = "en",
		platform = platform.detect(),
	}, start_shardpilot)
end

function update(self, dt)
	if started then
		shardpilot.update(dt) -- drives flush timer + frame sampling
	end
end

function final(self)
	if not started then
		return -- the decision never arrived; there is no SDK to shut down
	end
	-- shutdown() starts a final flush. Events it cannot deliver are written to
	-- the durable offline spool and re-sent on the next launch, so shutdown
	-- returns true even when the network is down. An undelivered consent
	-- receipt is handled the same way — durably retained in the consent
	-- outbox, it re-sends next launch — so shutdown returns
	-- false, "consent_pending" only when the receipt could NOT be durably
	-- captured (retry shutdown then); with spool_enabled = false it
	-- returns false, err whenever events remain undelivered.
	local ok, err = shardpilot.shutdown("app_final")
	if not ok then
		print("shardpilot shutdown not complete: " .. tostring(err))
	end
	local crash_ok, crash_err = crash.shutdown()
	if not crash_ok then
		print("shardpilot crash shutdown not complete: " .. tostring(crash_err))
	end
end
