{
  "version": 1,
  "status": "contract_only",
  "method": "POST",
  "path": "/v1/consent",
  "request_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "workspace_key",
      "app_key",
      "environment_key",
      "actor_identifier",
      "kind",
      "decided_at",
      "idempotency_key",
      "admission_basis",
      "purpose",
      "advisory",
      "age_evidence_class",
      "attestation",
      "notice_version",
      "notice_locale",
      "policy_version"
    ],
    "properties": {
      "workspace_key": {
        "type": "string",
        "minLength": 1
      },
      "app_key": {
        "type": "string",
        "minLength": 1
      },
      "environment_key": {
        "type": "string",
        "minLength": 1
      },
      "actor_identifier": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "format": "utf8-bytes-512"
      },
      "kind": {
        "enum": [
          "anon",
          "user_verified"
        ]
      },
      "decided_at": {
        "type": "string",
        "format": "date-time"
      },
      "idempotency_key": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "format": "utf8-bytes-128"
      },
      "admission_basis": {
        "const": "advisory_non_objection"
      },
      "purpose": {
        "const": "analytics"
      },
      "advisory": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "matrix",
          "row_id",
          "jurisdiction"
        ],
        "properties": {
          "matrix": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "docs_commit",
              "file_sha256",
              "date"
            ],
            "properties": {
              "docs_commit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "pattern": "^[a-f0-9]{40}$"
              },
              "file_sha256": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-f0-9]{64}$"
              },
              "date": {
                "type": "string",
                "format": "date"
              }
            }
          },
          "row_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "jurisdiction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2,
            "pattern": "^[A-Z]{2}$"
          }
        }
      },
      "age_evidence_class": {
        "const": "eligible_adult"
      },
      "attestation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "notice_provided",
          "free_simple_objection_provided",
          "did_not_object",
          "eligible"
        ],
        "properties": {
          "notice_provided": {
            "const": true
          },
          "free_simple_objection_provided": {
            "const": true
          },
          "did_not_object": {
            "const": true
          },
          "eligible": {
            "const": true
          }
        }
      },
      "notice_version": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9._+/-]+$"
      },
      "notice_locale": {
        "type": "string",
        "minLength": 2,
        "maxLength": 35,
        "format": "bcp47-2-35-bytes",
        "pattern": "^[A-Za-z0-9-]+$"
      },
      "policy_version": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9._+/-]+$"
      }
    }
  },
  "response_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "recorded",
      "replayed",
      "admission_basis"
    ],
    "properties": {
      "recorded": {
        "const": true
      },
      "replayed": {
        "type": "boolean"
      },
      "admission_basis": {
        "const": "advisory_non_objection"
      }
    }
  },
  "golden": {
    "request": "{\"workspace_key\":\"example-workspace\",\"app_key\":\"example-app\",\"environment_key\":\"production\",\"actor_identifier\":\"synthetic-player-001\",\"kind\":\"anon\",\"decided_at\":\"2026-10-22T12:00:00Z\",\"idempotency_key\":\"019a0d25-3600-7000-8000-000000000001\",\"admission_basis\":\"advisory_non_objection\",\"purpose\":\"analytics\",\"advisory\":{\"matrix\":{\"docs_commit\":\"1111111111111111111111111111111111111111\",\"file_sha256\":\"2222222222222222222222222222222222222222222222222222222222222222\",\"date\":\"2026-10-07\"},\"row_id\":\"GB\",\"jurisdiction\":\"GB\"},\"age_evidence_class\":\"eligible_adult\",\"attestation\":{\"notice_provided\":true,\"free_simple_objection_provided\":true,\"did_not_object\":true,\"eligible\":true},\"notice_version\":\"notice-1\",\"notice_locale\":\"en\",\"policy_version\":\"policy-1\"}",
    "response": "{\"recorded\":true,\"replayed\":false,\"admission_basis\":\"advisory_non_objection\"}\n"
  },
  "validation_profile": {
    "assert_formats": true,
    "required_formats": {
      "date": {
        "kind": "date"
      },
      "date-time": {
        "kind": "date-time"
      },
      "utf8-bytes-512": {
        "kind": "utf8_bytes",
        "min_bytes": 1,
        "max_bytes": 512
      },
      "utf8-bytes-128": {
        "kind": "utf8_bytes",
        "min_bytes": 1,
        "max_bytes": 128
      },
      "bcp47-2-35-bytes": {
        "kind": "bcp47",
        "min_bytes": 2,
        "max_bytes": 35
      }
    }
  }
}
